  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://slide-engage.vercel.app/taskpane"/>
  </DefaultSettings>

  <Permissions>ReadDocument</Permissions>
